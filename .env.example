# Production Pipeline Configuration

# WordPress Configuration (REQUIRED)
WP_URL=https://www.avoltium.in
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=your_wp_app_password

# AI Model APIs (At least one required for content generation)
# Gemini API - Cheaper option
GEMINI_API_KEY=your_gemini_api_key

# Claude API - Premium quality
ANTHROPIC_API_KEY=your_anthropic_api_key

# Image Sourcing APIs (At least Pexels recommended)
PEXELS_API_KEY=your_pexels_api_key
UNSPLASH_API_KEY=your_unsplash_api_key
PIXABAY_API_KEY=your_pixabay_api_key

# AdSense Configuration
ADSENSE_CLIENT=ca-pub-8459363476525914
ADSENSE_SLOT_ID=your_adsense_slot_id

# OmniRoute Gateway (Optional - for cost optimization)
OMNIROUTE_BASE_URL=https://your-omniroute-gateway.com
OMNIROUTE_API_KEY=your_omniroute_api_key

# Revenue Tracking Database (Optional)
REVENUE_DB_PATH=/tmp/avoltium_revenue.db

# Logging
LOG_LEVEL=INFO
